            "title": "Kalapastangan",
            "artist": "fitterkarma",
            "video": {
                "videoId": "EYmcKf4rnQs",
                "title": "Kalapastangan — fitterkarma"
            },
            "lyricCues": [
                {
                    "text": "Oras nang sambahin ang ngalan mo",
                    "start": 5.22,
                    "end": 17.02
                },
                {
                    "text": "Para mabuhay habambuhay sa puso't isipan mo",
                    "start": 17.02,
                    "end": 28.86
                },
                {
                    "text": "Sino ba ako para mapansin mo",
                    "start": 28.86,
                    "end": 40.7
                },
                {
                    "text": "Mga dalangin ko sa'yo sana'y pakinggan mo",
                    "start": 40.7,
                    "end": 64.49
                },
                {
                    "text": "Pa'no ba ako magiging 'sang santo",
                    "start": 64.49,
                    "end": 76.28
                },
                {
                    "text": "Para makasama kita diyan sa tabi ng trono mo",
                    "start": 76.28,
                    "end": 88.21
                },
                {
                    "text": "Ilan pa'ng pagsubok ang daraanan ko",
                    "start": 88.21,
                    "end": 99.97
                },
                {
                    "text": "Bago ako makaranas ng mga milagro mo",
                    "start": 99.97,
                    "end": 129.53
                },
                {
                    "text": "O ang langit ay nandito lamang pala sa lupa",
                    "start": 129.53,
                    "end": 138.49
                },
                {
                    "text": "At ang impyerno ay nasa isipan ko at pinalimot ng iyong ganda",
                    "start": 138.49,
                    "end": 147.74
                },
                {
                    "text": "Umaawit ang mga anghel",
                    "start": 147.74,
                    "end": 152.1
                },
                {
                    "text": "Umaawit ang mga anghel",
                    "start": 152.1,
                    "end": 156.5
                },
                {
                    "text": "Nagdiriwang sila nang makasama kita",
                    "start": 156.5,
                    "end": 160.94
                },
                {
                    "text": "Huwag ka sanang mawawala",
                    "start": 160.94,
                    "end": 183.37
                },
                {
                    "text": "Mamamatay akong nakangiti",
                    "start": 183.37,
                    "end": 187.62
                },
                {
                    "text": "Kapag ikaw ang nasa aking tabi",
                    "start": 187.62,
                    "end": 191.9
                },
                {
                    "text": "Mabubuhay akong nagsisisi",
                    "start": 191.9,
                    "end": 196.54
                },
                {
                    "text": "Kapag isang araw hindi kita mapangiti",
                    "start": 196.54,
                    "end": 201.02
                },
                {
                    "text": "Kalapastangan ang 'di ka ibigin",
                    "start": 201.02,
                    "end": 205.58
                },
                {
                    "text": "Kalokohan ang 'di ka isipin",
                    "start": 205.58,
                    "end": 209.82
                },
                {
                    "text": "Kung ang mundo ay biglang gugunawin",
                    "start": 209.82,
                    "end": 213.57
                },
                {
                    "text": "Ikaw ang una kong hahanapin",
                    "start": 213.57,
                    "end": 247.21
                }
            ],
            "timingReferenceDuration": 261,
            "timingSource": "lrclib"
